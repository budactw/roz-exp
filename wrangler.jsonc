{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "roz-exp",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/s/*"]
  },
  // 回報 API 速率限制：每個 IP 每分鐘 2 次
  "ratelimits": [
    { "name": "REPORT_LIMIT", "namespace_id": "1001", "simple": { "limit": 2, "period": 60 } },
    // 短網址建立：每個 IP 每分鐘 20 次
    { "name": "SHORT_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  // 短網址：/s/代號 → 分享連結（配裝 #s=、技能樹 #k=），一年沒人打開自動刪除
  "kv_namespaces": [
    { "binding": "SHORT", "id": "e64a22c803b5450a8800362586676fc6" }
  ],
  "observability": { "enabled": true }
}
